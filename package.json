{
  "name": "listmonk-mcp",
  "version": "0.1.0",
  "description": "MCP server for self-hosted Listmonk: lists, subscribers, campaigns, templates, bounces, transactional email",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "listmonk-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "selftest": "node scripts/selftest.mjs",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}