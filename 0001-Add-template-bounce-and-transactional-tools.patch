diff --git a/src/tools/bounces.ts b/src/tools/bounces.ts
new file mode 100644
index 0000000..9778377
--- /dev/null
+++ b/src/tools/bounces.ts
@@ -0,0 +1,62 @@
+import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { z } from "zod";
+import type { Config } from "../config.js";
+import type { ListmonkClient } from "../listmonk.js";
+import { registerTool } from "./helpers.js";
+
+export function registerBounceTools(server: McpServer, cfg: Config, lm: ListmonkClient): number {
+  let n = 0;
+
+  n += +registerTool(
+    server,
+    cfg,
+    {
+      name: "bounces_search",
+      title: "Search bounces",
+      description: "Recorded bounces, newest first. Filter by bounce type (soft, hard, complaint) and campaign.",
+      kind: "read",
+      inputSchema: {
+        type: z.enum(["soft", "hard", "complaint"]).optional(),
+        campaign_id: z.number().int().positive().optional(),
+        page: z.number().int().min(1).default(1),
+        per_page: z.number().int().min(1).max(100).default(20),
+      },
+    },
+    async (args) =>
+      lm.get("/bounces", {
+        type: args.type as string | undefined,
+        campaign_id: args.campaign_id as number | undefined,
+        page: args.page as number,
+        per_page: args.per_page as number,
+      }),
+  );
+
+  n += +registerTool(
+    server,
+    cfg,
+    {
+      name: "bounce_get",
+      title: "Get bounce",
+      description: "One bounce record by id.",
+      kind: "read",
+      inputSchema: { id: z.number().int().positive() },
+    },
+    async (args) => lm.get(`/bounces/${Number(args.id)}`),
+  );
+
+  n += +registerTool(
+    server,
+    cfg,
+    {
+      name: "bounce_delete",
+      title: "Delete bounce record",
+      description:
+        "Delete a bounce record by id. Does not change the subscriber's status; use subscriber_update to re-enable a subscriber.",
+      kind: "destructive",
+      inputSchema: { id: z.number().int().positive() },
+    },
+    async (args) => lm.del(`/bounces/${Number(args.id)}`),
+  );
+
+  return n;
+}
diff --git a/src/tools/templates.ts b/src/tools/templates.ts
new file mode 100644
index 0000000..5e8ab34
--- /dev/null
+++ b/src/tools/templates.ts
@@ -0,0 +1,100 @@
+import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { z } from "zod";
+import type { Config } from "../config.js";
+import type { ListmonkClient } from "../listmonk.js";
+import { registerTool } from "./helpers.js";
+
+export function registerTemplateTools(server: McpServer, cfg: Config, lm: ListmonkClient): number {
+  let n = 0;
+
+  n += +registerTool(
+    server,
+    cfg,
+    {
+      name: "templates_list",
+      title: "List templates",
+      description: "All campaign and transactional templates with id, name, type, and default flag.",
+      kind: "read",
+      inputSchema: {},
+    },
+    async () => lm.get("/templates"),
+  );
+
+  n += +registerTool(
+    server,
+    cfg,
+    {
+      name: "template_get",
+      title: "Get template",
+      description: "One template by id, including its HTML body.",
+      kind: "read",
+      inputSchema: { id: z.number().int().positive() },
+    },
+    async (args) => lm.get(`/templates/${Number(args.id)}`),
+  );
+
+  n += +registerTool(
+    server,
+    cfg,
+    {
+      name: "template_create",
+      title: "Create template",
+      description:
+        "Create a template. type is 'campaign' (for campaigns) or 'tx' (for transactional sends). body must contain {{ template \"content\" . }} for campaign templates.",
+      kind: "write",
+      inputSchema: {
+        name: z.string().min(1),
+        type: z.enum(["campaign", "tx"]),
+        subject: z.string().default(""),
+        body: z.string().min(1),
+      },
+    },
+    async (args) => lm.post("/templates", { name: args.name, type: args.type, subject: args.subject, body: args.body }),
+  );
+
+  n += +registerTool(
+    server,
+    cfg,
+    {
+      name: "template_update",
+      title: "Update template",
+      description: "Update a template. Only the fields you pass change.",
+      kind: "write",
+      inputSchema: {
+        id: z.number().int().positive(),
+        name: z.string().min(1).optional(),
+        subject: z.string().optional(),
+        body: z.string().optional(),
+      },
+    },
+    async (args) => {
+      const id = Number(args.id);
+      const current = await lm.get<Record<string, any>>(`/templates/${id}`);
+      const merged = {
+        name: current.name,
+        type: current.type,
+        subject: current.subject ?? "",
+        body: current.body,
+        ...(args.name !== undefined ? { name: args.name } : {}),
+        ...(args.subject !== undefined ? { subject: args.subject } : {}),
+        ...(args.body !== undefined ? { body: args.body } : {}),
+      };
+      return lm.put(`/templates/${id}`, merged);
+    },
+  );
+
+  n += +registerTool(
+    server,
+    cfg,
+    {
+      name: "template_delete",
+      title: "Delete template",
+      description: "Permanently delete a template. Listmonk refuses to delete the default template or one in use by a campaign.",
+      kind: "destructive",
+      inputSchema: { id: z.number().int().positive() },
+    },
+    async (args) => lm.del(`/templates/${Number(args.id)}`),
+  );
+
+  return n;
+}
diff --git a/src/tools/transactional.ts b/src/tools/transactional.ts
new file mode 100644
index 0000000..bf3e603
--- /dev/null
+++ b/src/tools/transactional.ts
@@ -0,0 +1,40 @@
+import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { z } from "zod";
+import type { Config } from "../config.js";
+import type { ListmonkClient } from "../listmonk.js";
+import { registerTool } from "./helpers.js";
+
+export function registerTransactionalTools(server: McpServer, cfg: Config, lm: ListmonkClient): number {
+  let n = 0;
+
+  n += +registerTool(
+    server,
+    cfg,
+    {
+      name: "tx_send",
+      title: "Send transactional email",
+      description:
+        "Send one transactional email from a 'tx' template to a subscriber email. data fills template placeholders. Sends real mail.",
+      kind: "write",
+      inputSchema: {
+        template_id: z.number().int().positive(),
+        subscriber_email: z.string().email(),
+        data: z.record(z.unknown()).default({}),
+        content_type: z.enum(["html", "markdown", "plain"]).default("html"),
+        from_email: z.string().optional(),
+        subject: z.string().optional(),
+      },
+    },
+    async (args) =>
+      lm.post("/tx", {
+        template_id: args.template_id,
+        subscriber_email: args.subscriber_email,
+        data: args.data,
+        content_type: args.content_type,
+        ...(args.from_email ? { from_email: args.from_email } : {}),
+        ...(args.subject ? { subject: args.subject } : {}),
+      }),
+  );
+
+  return n;
+}
