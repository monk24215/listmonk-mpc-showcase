# listmonk-mcp — environment variables. Copy to .env. Never commit real values.

# ---- Required -------------------------------------------------------------
# Base URL of your Listmonk instance (no trailing /api).
LISTMONK_URL=http://127.0.0.1:9000

# Listmonk API user and token (Admin -> Users -> API user).
LISTMONK_API_USER=CHANGE_ME
LISTMONK_API_TOKEN=CHANGE_ME

# ---- Optional -------------------------------------------------------------
# true = write and destructive tools are not registered (read-only mode).
LISTMONK_MCP_READONLY=false

# HTTP transport only (MCP_TRANSPORT=http). Clients must send
# "Authorization: Bearer <token>" or use the /mcp/<token> path.
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3100
MCP_HTTP_TOKEN=CHANGE_ME_LONG_RANDOM